  <file source-language="en" datatype="plaintext" original="messages" date="2026-05-17T00:00:00Z" product-name="t3_simplecmp">
    <header/>
    <body>
      <trans-unit id="simplecmp.parent"><source>SimpleCMP</source></trans-unit>

      <trans-unit id="mlang_tabs_tab"><source>SimpleCMP banner design</source></trans-unit>
      <trans-unit id="mlang_labels_tablabel"><source>Customise the consent banner</source></trans-unit>
      <trans-unit id="mlang_labels_tabdescr"><source>Configure the colors, typography, and corner radius of the SimpleCMP consent banner per Site Set. Changes apply to the next frontend page render.</source></trans-unit>

      <trans-unit id="designer.title"><source>Banner design</source></trans-unit>
      <trans-unit id="designer.intro"><source>Customise how the SimpleCMP consent banner looks on your site. Each Site Set has its own theme; changes take effect on the next frontend page render.</source></trans-unit>

      <!-- Compliance-audit banner shown above the form -->
      <trans-unit id="designer.audit.title"><source>Compliance check</source></trans-unit>
      <trans-unit id="designer.audit.intro"><source>The banner configuration was checked against current data-protection requirements (GDPR / ePrivacy / DSK / VG Hannover / EDPB). Click the section reference on any finding to read the full explanation in the compliance reference.</source></trans-unit>
      <trans-unit id="designer.audit.allPassed"><source>All compliance checks passed.</source></trans-unit>
      <trans-unit id="designer.audit.allPassedDetail"><source>%d checks ran against the current site configuration; no findings.</source></trans-unit>
      <trans-unit id="designer.audit.passedToggle"><source>Show %d checks that passed</source></trans-unit>
      <trans-unit id="designer.audit.criticalCount"><source>%d critical issue(s)</source></trans-unit>
      <trans-unit id="designer.audit.warningCount"><source>%d warning(s)</source></trans-unit>
      <trans-unit id="designer.audit.severity.critical"><source>Critical</source></trans-unit>
      <trans-unit id="designer.audit.severity.warning"><source>Warning</source></trans-unit>
      <trans-unit id="designer.audit.openReference"><source>Open compliance reference</source></trans-unit>
      <trans-unit id="designer.audit.sectionLink"><source>Read about §%s in the compliance reference</source></trans-unit>

      <!-- Per-check title + pass/fail detail strings. Mirrors upstream simplecmp.audit() check IDs. -->
      <trans-unit id="designer.audit.title.privacy-policy-url"><source>Privacy-policy URL configured</source></trans-unit>
      <trans-unit id="designer.audit.pass.privacy-policy-url"><source>The privacy-policy URL is set in the site configuration.</source></trans-unit>
      <trans-unit id="designer.audit.fail.privacy-policy-url"><source>The privacy-policy URL is missing. Set `simplecmp.privacyPolicyUrl` in the site settings — the banner cannot render the required link otherwise.</source></trans-unit>

      <trans-unit id="designer.audit.title.first-layer-reject"><source>"Reject all" available on the first layer</source></trans-unit>
      <trans-unit id="designer.audit.pass.first-layer-reject"><source>The Reject affordance is present on the first banner layer.</source></trans-unit>
      <trans-unit id="designer.audit.fail.first-layer-reject"><source>`simplecmp.hideDeclineAll` is enabled — that removes the Reject button from the first layer, which courts treat as unlawful. Switch the setting off.</source></trans-unit>

      <trans-unit id="designer.audit.title.opt-in-defaults"><source>Non-essential services default to OFF</source></trans-unit>
      <trans-unit id="designer.audit.pass.opt-in-defaults"><source>All non-essential services start in the "off" state.</source></trans-unit>
      <trans-unit id="designer.audit.fail.opt-in-defaults"><source>%d service(s) start pre-checked even though they are not essential: %s. Pre-ticked consent is invalid. Either mark them as required (genuinely essential) or remove the default flag in the service registry.</source></trans-unit>

      <trans-unit id="designer.audit.title.pre-consent-blocking"><source>Pre-consent tracking blocked</source></trans-unit>
      <trans-unit id="designer.audit.pass.pre-consent-blocking"><source>Pre-consent runtime blocking is enabled.</source></trans-unit>
      <trans-unit id="designer.audit.fail.pre-consent-blocking"><source>Pre-consent blocking is off — third-party scripts may fire before the visitor has made any choice, which violates the rule that no non-essential cookies/storage may be set before consent. Enable `simplecmp.universalBlocking.enabled` in the site settings.</source></trans-unit>

      <trans-unit id="designer.audit.title.persistent-revocation-trigger"><source>Persistent revocation trigger enabled</source></trans-unit>
      <trans-unit id="designer.audit.pass.persistent-revocation-trigger"><source>The persistent revocation trigger has a visible label.</source></trans-unit>
      <trans-unit id="designer.audit.fail.persistent-revocation-trigger"><source>`simplecmp.floatingTriggerLabel` is empty — the visitor has no visible affordance to reopen the consent banner. Set a label, e.g. "Cookie settings".</source></trans-unit>

      <trans-unit id="designer.audit.title.imprint-url-dach"><source>Imprint URL configured (DACH)</source></trans-unit>
      <trans-unit id="designer.audit.pass.imprint-url-dach"><source>The imprint URL is set in the site configuration.</source></trans-unit>
      <trans-unit id="designer.audit.fail.imprint-url-dach"><source>The imprint URL is missing. DACH jurisdictions require a separately reachable imprint; set `simplecmp.imprintUrl` in the site settings or skip this finding if the site is not aimed at DACH visitors.</source></trans-unit>

      <trans-unit id="designer.audit.title.services-have-purposes"><source>Each service declares processing purposes</source></trans-unit>

      <!-- DOM-level check titles. Mirrors upstream `src/audit/dom.ts` IDs. -->
      <trans-unit id="designer.audit.title.dom-buttons-are-buttons"><source>Banner action elements are real buttons</source></trans-unit>
      <trans-unit id="designer.audit.title.dom-buttons-equal-styling"><source>Banner buttons are styled identically</source></trans-unit>
      <trans-unit id="designer.audit.title.dom-buttons-wcag-contrast"><source>Banner buttons meet WCAG AA text contrast</source></trans-unit>
      <trans-unit id="designer.audit.domHeading"><source>From the rendered banner</source></trans-unit>
      <trans-unit id="designer.audit.feAudit.run"><source>Run live FE audit</source></trans-unit>
      <trans-unit id="designer.audit.feAudit.idle"><source>Tests the banner on the live site (catches host-CSS conflicts the BE preview can't see)</source></trans-unit>
      <trans-unit id="designer.audit.feAudit.running"><source>Running on live FE…</source></trans-unit>
      <trans-unit id="designer.audit.feAudit.done"><source>Last live FE check: %s</source></trans-unit>
      <trans-unit id="designer.audit.feAudit.heading"><source>From the live frontend (%s)</source></trans-unit>
      <trans-unit id="designer.audit.feAudit.allPassed"><source>All checks on the live frontend passed.</source></trans-unit>
      <trans-unit id="designer.audit.feAudit.timeout"><source>No response from %s after 10 seconds. Check that the site is reachable and that the SimpleCMP bundle is loaded there.</source></trans-unit>
      <trans-unit id="designer.audit.pass.services-have-purposes"><source>All services declare at least one processing purpose.</source></trans-unit>
      <trans-unit id="designer.audit.fail.services-have-purposes"><source>%d service(s) have no purposes declared: %s. Consent must be specific per purpose — tag each service with at least one purpose category in the service registry.</source></trans-unit>

      <trans-unit id="designer.audit.title.heuristic-decline-label-clarity"><source>Reject button labels read as clear refusal</source></trans-unit>
      <trans-unit id="designer.audit.pass.heuristic-decline-label-clarity"><source>The reject button labels read as clear refusal across configured languages.</source></trans-unit>
      <trans-unit id="designer.audit.fail.heuristic-decline-label-clarity"><source>%d reject button label(s) read as deferral or postponement instead of refusal — the EDPB Deceptive-Design Guidelines (03/2022) flag this as Skipping. Either revert to the bundle default or rephrase: %s</source></trans-unit>

      <trans-unit id="designer.audit.title.heuristic-no-marketing-nudge-in-description"><source>Banner description avoids marketing nudges</source></trans-unit>
      <trans-unit id="designer.audit.pass.heuristic-no-marketing-nudge-in-description"><source>Banner descriptions stay clear of marketing-nudge language.</source></trans-unit>
      <trans-unit id="designer.audit.fail.heuristic-no-marketing-nudge-in-description"><source>%d banner description(s) contain marketing-nudge phrases that push visitors toward accepting — EDPB 03/2022 Stirring and CNIL recommendation 17.09.2020 rule this out. Replace the flagged phrases with neutral wording: %s</source></trans-unit>

      <trans-unit id="designer.audit.title.heuristic-paired-token-overrides"><source>Paired color values overridden together</source></trans-unit>
      <trans-unit id="designer.audit.pass.heuristic-paired-token-overrides"><source>Related color values have been overridden as pairs — visual relationships stay coherent.</source></trans-unit>
      <trans-unit id="designer.audit.fail.heuristic-paired-token-overrides"><source>%d color pair(s) are out of balance — only one half was overridden, the other still uses the default. The rendered banner will show mismatched hover states or surface relationships. Either tune both or revert one: %s</source></trans-unit>
      <trans-unit id="designer.audit.title.heuristic-banner-contrast"><source>Banner contrast meets WCAG-AA</source></trans-unit>
      <trans-unit id="designer.audit.pass.heuristic-banner-contrast"><source>Banner text and primary-button colors pass the 4.5:1 contrast threshold.</source></trans-unit>
      <trans-unit id="designer.audit.fail.heuristic-banner-contrast"><source>%d color pair(s) fall below the WCAG-AA contrast threshold of 4.5:1 — visitors may struggle to read the banner: %s</source></trans-unit>

      <trans-unit id="designer.audit.title.heuristic-button-equal-prominence"><source>Banner buttons are equal-prominence</source></trans-unit>
      <trans-unit id="designer.audit.pass.heuristic-button-equal-prominence"><source>Accept, Decline and Configure share the same neutral background — visitors aren't nudged toward Accept (BGH "Cookie II", 1 BvR 2783/19).</source></trans-unit>
      <trans-unit id="designer.audit.fail.heuristic-button-equal-prominence"><source>%d banner button(s) carry a custom background — this breaks the equal-prominence baseline required by BGH "Cookie II". Visitors may be nudged toward the more prominent option, which the courts treat as invalid consent: %s</source></trans-unit>

      <trans-unit id="designer.audit.title.heuristic-description-length"><source>Banner description sits in a readable length range</source></trans-unit>
      <trans-unit id="designer.audit.pass.heuristic-description-length"><source>Banner descriptions are in the informative-but-readable range across configured languages.</source></trans-unit>
      <trans-unit id="designer.audit.fail.heuristic-description-length"><source>%d banner description(s) are outside the recommended 80–600 character range. Too short (below 80) typically lacks the purpose enumeration the "informed" consent prong requires; too long (above 600) risks EDPB 03/2022 § Overloading. Findings: %s</source></trans-unit>

      <trans-unit id="designer.audit.title.dom-accessible-names"><source>Banner region and actions have accessible names (REQ-N11)</source></trans-unit>
      <trans-unit id="designer.audit.pass.dom-accessible-names"><source>No editor-blanked override removes a banner button label or the banner region title. Run `?simplecmp_audit=1` on the live frontend to additionally verify the rendered shadow-DOM aria attributes.</source></trans-unit>
      <trans-unit id="designer.audit.fail.dom-accessible-names"><source>%d banner-label override(s) are explicitly blank — the rendered button or region will have no accessible name, so assistive tech can't identify or operate it (WCAG 4.1.2 / 2.4.6, consent that can't be perceived isn't valid). Either restore the bundle default by deleting the override, or set a non-empty value: %s</source></trans-unit>

      <trans-unit id="designer.compliance.title"><source>Compliance reference</source></trans-unit>
      <trans-unit id="designer.compliance.backToDesigner"><source>Back to banner design</source></trans-unit>
      <trans-unit id="designer.compliance.intro"><source>This reference explains the legal requirements the SimpleCMP audit checks against. Each section corresponds to a section in the compliance audit banner above the design form.</source></trans-unit>

      <trans-unit id="designer.sitePicker.label"><source>Site</source></trans-unit>
      <trans-unit id="designer.sitePicker.customBadge"><source>Custom theme active</source></trans-unit>
      <trans-unit id="designer.languagePicker.label"><source>Preview language</source></trans-unit>

      <!-- Policy URLs status block — shown below the live preview -->
      <trans-unit id="designer.policyUrls.heading"><source>Privacy policy &amp; imprint URLs (read-only here)</source></trans-unit>
      <trans-unit id="designer.policyUrls.privacy"><source>Privacy policy</source></trans-unit>
      <trans-unit id="designer.policyUrls.imprint"><source>Imprint (Impressum)</source></trans-unit>
      <trans-unit id="designer.policyUrls.unset"><source>not configured</source></trans-unit>
      <trans-unit id="designer.policyUrls.editAction"><source>Edit in Site settings</source></trans-unit>

      <!-- Empty-state shown when no site has the SimpleCMP Site Set in its dependencies -->
      <trans-unit id="designer.emptyState.title"><source>No site uses SimpleCMP yet</source></trans-unit>
      <trans-unit id="designer.emptyState.message"><source>Banner design can only be configured for sites whose configuration includes the &quot;%s&quot; Site Set. None of your sites does at the moment, so the FE bundle never loads and there is nothing to theme here.</source></trans-unit>
      <trans-unit id="designer.emptyState.knownSites"><source>Sites detected in this installation:</source></trans-unit>
      <trans-unit id="designer.emptyState.howTo"><source>Add the SimpleCMP set to one of the configs above by appending these lines to the `dependencies:` block, then reload this module:</source></trans-unit>

      <trans-unit id="designer.group.brand"><source>Brand colors</source></trans-unit>
      <trans-unit id="designer.group.surface"><source>Text &amp; background</source></trans-unit>
      <trans-unit id="designer.group.advanced"><source>Advanced colors</source></trans-unit>
      <trans-unit id="designer.group.banner-buttons"><source>Banner buttons (compliance-critical)</source></trans-unit>
      <trans-unit id="designer.group.placement"><source>Banner placement</source></trans-unit>
      <trans-unit id="designer.group.framework"><source>CSS framework</source></trans-unit>
      <trans-unit id="designer.group.template"><source>Banner template</source></trans-unit>
      <trans-unit id="designer.group.trigger"><source>Floating trigger</source></trans-unit>
      <trans-unit id="designer.field.triggerPosition"><source>Trigger corner</source></trans-unit>
      <trans-unit id="designer.field.triggerPosition.hint"><source>Where the persistent "cookie settings" button sits after the visitor closes the banner. Four corners, no center options — the trigger is meant to stay out of the way.</source></trans-unit>
      <trans-unit id="designer.field.color-trigger-bg"><source>Trigger background (optional)</source></trans-unit>
      <trans-unit id="designer.group.overrides"><source>Override banner texts</source></trans-unit>
      <trans-unit id="designer.unsaved"><source>Unsaved changes</source></trans-unit>
      <trans-unit id="designer.group.colors"><source>Colors</source></trans-unit>
      <trans-unit id="designer.group.stylePresets"><source>Banner style</source></trans-unit>
      <trans-unit id="designer.stylePresets.intro"><source>Pick a preset for the banner shape. The position picker below lets you fine-tune the exact placement.</source></trans-unit>
      <trans-unit id="designer.colors.complianceSafe"><source>Compliance-safe palette active</source></trans-unit>
      <trans-unit id="designer.colors.customRisk"><source>Custom colors — compliance not guaranteed</source></trans-unit>
      <trans-unit id="designer.colors.useCustom"><source>Use custom colors</source></trans-unit>
      <trans-unit id="designer.colors.useCustom.help"><source>Off: the banner ships with the audited safe palette (equal-prominence buttons, WCAG-AA contrast). On: edit the colors freely — you take responsibility for the compliance check.</source></trans-unit>
      <trans-unit id="designer.colors.unlocked.warning"><source>Custom colors active.</source></trans-unit>
      <trans-unit id="designer.colors.unlocked.warning.body"><source>The values you set here override the safe palette on the live site. Check the compliance status box below for warnings on contrast or button equal-prominence.</source></trans-unit>
      <trans-unit id="designer.overrides.intro"><source>Override individual bundle strings for one language at a time. Use this to choose formal vs. informal tone (Du/Sie etc.) or to fully rewrite a button label. Leave a field empty to fall back to the bundle's default.</source></trans-unit>
      <trans-unit id="designer.overrides.scopeLabel"><source>Editing language</source></trans-unit>
      <trans-unit id="designer.overrides.toneLabel"><source>Tone</source></trans-unit>
      <trans-unit id="designer.overrides.toneFormal"><source>Formal</source></trans-unit>
      <trans-unit id="designer.overrides.toneInformal"><source>Informal</source></trans-unit>
      <trans-unit id="designer.overrides.placeholder"><source>(uses bundle default)</source></trans-unit>
      <trans-unit id="designer.overrides.clear"><source>Clear field</source></trans-unit>
      <trans-unit id="designer.overrides.defaultLabel"><source>Default</source></trans-unit>
      <trans-unit id="designer.overrides.defaultFallback"><source>the bundle's translation in this language — see the live preview on the right</source></trans-unit>
      <trans-unit id="designer.overrides.defaultLoading"><source>(loading…)</source></trans-unit>
      <trans-unit id="designer.overrides.defaultMissing"><source>(no default text)</source></trans-unit>
      <trans-unit id="designer.overrides.activeBadge"><source>override active</source></trans-unit>
      <!-- Per-key human-readable labels for the override fieldset. The dotted bundle key still renders below in <code> for editors who know the bundle internals. -->
      <trans-unit id="designer.overrides.label.consentNotice.title"><source>Banner heading</source></trans-unit>
      <trans-unit id="designer.overrides.label.consentNotice.description"><source>Banner description (main text)</source></trans-unit>
      <trans-unit id="designer.overrides.label.consentNotice.changeDescription"><source>Banner description on return visit (after consent changed)</source></trans-unit>
      <trans-unit id="designer.overrides.label.consentNotice.learnMore"><source>"Configure" button label</source></trans-unit>
      <trans-unit id="designer.overrides.label.consentNotice.testing"><source>"Testing mode" notice</source></trans-unit>
      <trans-unit id="designer.overrides.label.consentModal.title"><source>Modal heading (settings dialog)</source></trans-unit>
      <trans-unit id="designer.overrides.label.consentModal.description"><source>Modal description (above the service list)</source></trans-unit>
      <trans-unit id="designer.overrides.label.privacyPolicy.name"><source>Privacy-policy link text</source></trans-unit>
      <trans-unit id="designer.overrides.label.imprint.name"><source>Imprint link text (standalone footer)</source></trans-unit>
      <trans-unit id="designer.overrides.label.consentNotice.imprint.name"><source>Imprint link text (next to privacy policy)</source></trans-unit>
      <trans-unit id="designer.overrides.label.acceptAll"><source>"Accept all" button label</source></trans-unit>
      <trans-unit id="designer.overrides.label.acceptSelected"><source>"Accept selected" button label</source></trans-unit>
      <trans-unit id="designer.overrides.label.decline"><source>"Decline" button label</source></trans-unit>
      <trans-unit id="designer.overrides.label.save"><source>"Save" button label</source></trans-unit>
      <trans-unit id="designer.overrides.label.ok"><source>"OK" button label (banner accept)</source></trans-unit>

      <trans-unit id="designer.field.color-primary"><source>Accent color (trigger button, links, focus ring, modal accents)</source></trans-unit>
      <trans-unit id="designer.field.color-primary.hint"><source>Used by the floating revocation trigger, links, focus rings on interactive elements, and accents inside the Configure modal. It does NOT color the banner's Accept / Decline / Configure buttons — those stay neutral and equal-prominence as required by BGH "Cookie II" so visitors aren't nudged toward Accept. For banner-button background see "Button background" below; for the trigger alone see "Trigger background".</source></trans-unit>
      <trans-unit id="designer.field.color-primary-hover"><source>Accent hover state (trigger button hover, link hover)</source></trans-unit>
      <trans-unit id="designer.field.color-text"><source>Body text</source></trans-unit>
      <trans-unit id="designer.field.color-text-muted"><source>Muted text (descriptions, hints)</source></trans-unit>
      <trans-unit id="designer.field.color-bg"><source>Card background</source></trans-unit>
      <trans-unit id="designer.field.color-bg-alt"><source>Button background (Accept, Decline, Configure)</source></trans-unit>
      <trans-unit id="designer.field.color-border"><source>Border</source></trans-unit>
      <trans-unit id="designer.field.color-danger"><source>Warning color (required-service indicator, validation hints)</source></trans-unit>
      <trans-unit id="designer.field.position"><source>Where the banner sits on screen</source></trans-unit>
      <trans-unit id="designer.field.theme"><source>Framework adapter</source></trans-unit>
      <trans-unit id="designer.field.theme.hint"><source>"Default" keeps SimpleCMP's own design values (plus your overrides above). Picking a framework re-binds those values to the host site's CSS variables (e.g. Bootstrap 5's --bs-*) — your color overrides still win on top.</source></trans-unit>
      <trans-unit id="designer.field.layout"><source>Banner template</source></trans-unit>
      <trans-unit id="designer.field.layout.hint"><source>Which buttons appear on the banner and how they are arranged. All three templates style the buttons identically — only their visibility and arrangement differs. "Compact" hides the "Configure" button on layer 1, so visitors reach the per-purpose settings via the persistent revocation trigger instead.</source></trans-unit>

      <trans-unit id="designer.field.triggerPosition.option.bottom-right"><source>Bottom right</source></trans-unit>
      <trans-unit id="designer.field.triggerPosition.option.bottom-left"><source>Bottom left</source></trans-unit>
      <trans-unit id="designer.field.triggerPosition.option.top-right"><source>Top right</source></trans-unit>
      <trans-unit id="designer.field.triggerPosition.option.top-left"><source>Top left</source></trans-unit>
      <trans-unit id="designer.field.color-trigger-bg.reset"><source>Use primary color</source></trans-unit>
      <trans-unit id="designer.field.color-trigger-bg.setCustom"><source>Custom color</source></trans-unit>
      <trans-unit id="designer.field.color-trigger-bg.unset"><source>(default)</source></trans-unit>
      <trans-unit id="designer.field.color-accept-bg"><source>"Accept" button background (optional)</source></trans-unit>
      <trans-unit id="designer.field.color-decline-bg"><source>"Decline" button background (optional)</source></trans-unit>
      <trans-unit id="designer.field.color-configure-bg"><source>"Configure" button background (optional)</source></trans-unit>
      <trans-unit id="designer.field.optionalColor.reset"><source>Reset to default</source></trans-unit>
      <trans-unit id="designer.field.optionalColor.setCustom"><source>Custom color</source></trans-unit>
      <trans-unit id="designer.field.optionalColor.unset"><source>(default)</source></trans-unit>

      <trans-unit id="designer.preview.title"><source>Live preview</source></trans-unit>
      <trans-unit id="designer.preview.help"><source>The consent banner updates as you edit. Click Configure inside the banner to see the modal with all services.</source></trans-unit>

      <trans-unit id="designer.action.save"><source>Save theme</source></trans-unit>
      <trans-unit id="designer.action.reset"><source>Reset to defaults</source></trans-unit>
      <trans-unit id="designer.action.reset.confirm"><source>Discard this site's custom theme and revert to the SimpleCMP defaults?</source></trans-unit>

      <!-- Per-issue detail strings injected into the compliance audit "sample" field -->
      <trans-unit id="audit.descriptionLength.tooShort"><source>[%s] %d characters — under %d, likely missing the purpose / controller information required for "informed" consent.</source></trans-unit>
      <trans-unit id="audit.descriptionLength.tooLong"><source>[%s] %d characters — over %d; overloading risk (EDPB 03/2022). Shorten to the essentials or move details into the modal.</source></trans-unit>

      <trans-unit id="audit.pairedToken.imbalance"><source>%s — "%s" overridden, "%s" left at default</source></trans-unit>
      <trans-unit id="audit.pairedToken.primary"><source>Primary color + hover</source></trans-unit>
      <trans-unit id="audit.pairedToken.background"><source>Card + button background</source></trans-unit>
      <trans-unit id="audit.pairedToken.text"><source>Text + muted text</source></trans-unit>

      <trans-unit id="audit.contrast.failure"><source>%s: %s on %s = %s:1 (target ≥ 4.5:1)</source></trans-unit>
      <trans-unit id="audit.contrast.bodyOnBanner"><source>Body text on banner background</source></trans-unit>
      <trans-unit id="audit.contrast.mutedOnBanner"><source>Muted text on banner background</source></trans-unit>
      <trans-unit id="audit.contrast.acceptButton"><source>Accept / Save button (modal)</source></trans-unit>

      <trans-unit id="audit.button.accept"><source>Accept</source></trans-unit>
      <trans-unit id="audit.button.decline"><source>Decline</source></trans-unit>
      <trans-unit id="audit.button.configure"><source>Configure</source></trans-unit>
