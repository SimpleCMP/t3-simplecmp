      <trans-unit id="tx_simplecmptypo3_service.i18n"><source>Translations (JSON)</source></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.cookies"><source>Cookie matchers (JSON array)</source></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.cookies.description"><source>Strings (exact match) or /regex/ (slash-bounded), e.g. ["_ga", "/^_ga_/", "_gid"].</source></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.origins"><source>Origin matchers (JSON array)</source></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.origins.description"><source>Host strings or wildcards, e.g. ["www.google-analytics.com", "*.doubleclick.net"].</source></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.extensions"><source>Extensions (JSON)</source></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.palette.protocol"><source>Protocol contract</source></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.palette.classification"><source>Classification (cookies + origins)</source></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.palette.metadata"><source>Metadata</source></trans-unit>

