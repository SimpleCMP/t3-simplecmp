      <!-- Service table -->
      <trans-unit id="tx_simplecmptypo3_service"><source>SimpleCMP service</source></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.service_id"><source>Service ID (slug)</source></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.service_id.description"><source>Stable kebab-case identifier, e.g. "google-analytics". Lower-case, no spaces.</source></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.name"><source>Display name</source></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.vendor"><source>Vendor</source></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.vendor_country"><source>Vendor country (ISO 3166)</source></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.purposes"><source>Purposes (JSON array)</source></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.purposes.description"><source>One of: functional, analytics, marketing, personalization, security, advertising. JSON array, e.g. ["analytics","marketing"].</source></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.privacy_policy_url"><source>Privacy policy URL</source></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.description"><source>Description</source></trans-unit>
