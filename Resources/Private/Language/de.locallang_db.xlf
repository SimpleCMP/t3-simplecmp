    <body>
      <trans-unit id="tx_simplecmptypo3_service"><source>SimpleCMP service</source><target>SimpleCMP-Dienst</target></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.service_id"><source>Service ID (slug)</source><target>Dienst-ID (Slug)</target></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.service_id.description"><source>Stable kebab-case identifier, e.g. "google-analytics". Lower-case, no spaces.</source><target>Stabiler Kebab-Case-Bezeichner, z. B. "google-analytics". Kleinbuchstaben, keine Leerzeichen.</target></trans-unit>
      <trans-unit id="tx_simplecmptypo3_service.name"><source>Display name</source><target>Anzeigename</target></trans-unit>
