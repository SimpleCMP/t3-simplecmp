      <trans-unit id="tx_t3simplecmp_detection.kind"><source>Kind</source><target>Typ</target></trans-unit>
      <trans-unit id="tx_t3simplecmp_detection.identifier"><source>Identifier (cookie name / URL)</source><target>Bezeichner (Cookie-Name / URL)</target></trans-unit>
      <trans-unit id="tx_t3simplecmp_detection.origin"><source>Origin (host)</source><target>Origin (Host)</target></trans-unit>
      <trans-unit id="tx_t3simplecmp_detection.page_url"><source>Page URL</source><target>Seiten-URL</target></trans-unit>
      <trans-unit id="tx_t3simplecmp_detection.first_seen_on"><source>First seen on (path)</source><target>Erstmals gesehen auf (Pfad)</target></trans-unit>
      <trans-unit id="tx_t3simplecmp_detection.sent_at"><source>Sent at (ISO timestamp)</source><target>Gesendet am (ISO-Zeitstempel)</target></trans-unit>
      <trans-unit id="tx_t3simplecmp_detection.first_seen"><source>First seen (epoch ms)</source><target>Erstmals gesehen (Epoch ms)</target></trans-unit>
      <trans-unit id="tx_t3simplecmp_detection.last_seen"><source>Last seen (epoch ms)</source><target>Zuletzt gesehen (Epoch ms)</target></trans-unit>
      <trans-unit id="tx_t3simplecmp_detection.received_at"><source>Received at</source><target>Empfangen am</target></trans-unit>
      <trans-unit id="tx_t3simplecmp_detection.occurrences"><source>Occurrences</source><target>Anzahl Vorkommen</target></trans-unit>
      <trans-unit id="tx_t3simplecmp_detection.library_version"><source>Library version</source><target>Bibliotheksversion</target></trans-unit>
      <trans-unit id="tx_t3simplecmp_detection.user_agent"><source>User agent</source><target>User-Agent</target></trans-unit>
      <trans-unit id="tx_t3simplecmp_detection.referrer"><source>Referrer</source><target>Referrer</target></trans-unit>
      <trans-unit id="tx_t3simplecmp_detection.payload"><source>Raw payload (JSON)</source><target>Roh-Payload (JSON)</target></trans-unit>
