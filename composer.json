{
  "name": "simplecmp/t3-simplecmp",
  "type": "typo3-cms-extension",
  "description": "TYPO3 integration for SimpleCMP — consent manager (banner + recorder + service DB + CMS bridge).",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Sven Wappler",
      "email": "wappler@wappler.systems"
    },
    {
      "name": "Ilja Melnicenko",
      "email": "melnicenko@wappler.systems"
    }
  ],
  "homepage": "https://github.com/SimpleCMP/t3-simplecmp",
  "require": {
    "php": "^8.3",
    "typo3/cms-core": "^14.0",
    "typo3/cms-frontend": "^14.0",
    "simplecmp/services-library": "^0.1"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/SimpleCMP/services-library"
    }
  ],
  "autoload": {
    "psr-4": {
      "SimpleCMP\\T3SimpleCmp\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SimpleCMP\\T3SimpleCmp\\Tests\\": "Tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "dg/bypass-finals": "^1.5",
    "typo3/testing-framework": "^9.5"
  },
  "scripts": {
    "test:unit": "phpunit --testsuite=unit",
    "test:functional": "phpunit --testsuite=functional",
    "test": ["@test:unit", "@test:functional"]
  },
  "config": {
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "t3_simplecmp"
    }
  }
}
