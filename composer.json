{
  "name": "wapplersystems/simplecmp-typo3",
  "type": "typo3-cms-extension",
  "description": "TYPO3 integration for SimpleCMP — consent manager (banner + recorder + service DB + CMS bridge).",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Sven Wappler",
      "email": "wappler@wappler.systems"
    },
    {
      "name": "Ilja Melnicenko",
      "email": "melnicenko@wappler.systems"
    }
  ],
  "homepage": "https://github.com/WapplerSystems/simplecmp-typo3",
  "require": {
    "php": "^8.3",
    "typo3/cms-core": "^14.0",
    "typo3/cms-frontend": "^14.0"
  },
  "autoload": {
    "psr-4": {
      "WapplerSystems\\SimpleCmpTypo3\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WapplerSystems\\SimpleCmpTypo3\\Tests\\": "Tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "dg/bypass-finals": "^1.5"
  },
  "scripts": {
    "test:unit": "phpunit --testsuite=unit"
  },
  "config": {
    "allow-plugins": {
      "typo3/class-alias-loader": true,
      "typo3/cms-composer-installers": true
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "simplecmp_typo3"
    }
  }
}
